{
  "name": "spy-lab",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run assets && tsc --noEmit && vite build && node scripts/post-build.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "assets": "node scripts/build-assets.mjs",
    "package": "node scripts/package.mjs",
    "check-build": "node scripts/check-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test tests/smoke.spec.ts tests/save.spec.ts tests/ads.spec.ts tests/mission.spec.ts tests/tutorial.spec.ts --trace off",
    "test:matrix": "playwright test tests/matrix.spec.ts --trace off --workers=3",
    "build:fast": "vite build && node scripts/post-build.mjs",
    "release": "npm run build && npm run check-build && npm run package",
    "sim": "node scripts/sim-economy.ts"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "archiver": "^8.0.0",
    "meshoptimizer": "^1.3.0",
    "obj2gltf": "^3.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@playgama/bridge": "^2.4.3",
    "@preact/signals": "^2.11.4",
    "@preact/signals-core": "^1.14.5",
    "preact": "^11.2.0",
    "three": "^0.187.0"
  }
}
